# ========================================================
# Gram Panchayat Portal Backend - Environment Configuration
# Copy this file to '.env' inside the 'backend' directory
# (DO NOT COMMIT SENSITIVE VALUES TO GITHUB)
# ========================================================

# Server Port (default: 5000)
PORT=5000
NODE_ENV=production

# --------------------------------------------------------
# Database Provider Selection ('mysql' or 'firestore')
# Default is 'mysql' for local development.
# Set to 'firestore' for Vercel production deployment.
# --------------------------------------------------------
DB_PROVIDER=firestore

# --------------------------------------------------------
# Option A: Google Cloud Firestore (Recommended for Vercel)
# Obtain these from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# --------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
# Note: For Vercel, paste the private key including BEGIN and END lines. Escaped \n is handled automatically.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# --------------------------------------------------------
# Option B: MySQL Database Connection (Local Development / Hosted MySQL)
# --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=jalmitra_db

# Enable SSL for cloud MySQL providers (Aiven, TiDB Cloud, Railway, AWS RDS)
DB_SSL=false
DB_CONNECTION_LIMIT=10

# --------------------------------------------------------
# Security, CORS & Authentication
# --------------------------------------------------------
# Allowed Frontend Origin for CORS (comma-separated if multiple)
FRONTEND_URL=https://gram-panchayat-portal-sandy.vercel.app

# Strong Random JWT Secret for Signing Authentication Tokens
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
