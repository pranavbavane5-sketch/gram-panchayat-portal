# ========================================================
# Gram Panchayat Portal Backend - Environment Configuration
# Copy this file to '.env' inside the 'backend' directory
# (DO NOT COMMIT SENSITIVE VALUES TO GITHUB)
# ========================================================

# Server Port (default: 5000)
PORT=5000
NODE_ENV=production

# --------------------------------------------------------
# MySQL Database Connection
# Option 1: Connection URI (common for Railway, Aiven, Supabase)
# DATABASE_URL=mysql://user:password@host:port/database?ssl-mode=REQUIRED
#
# Option 2: Discrete parameters (traditional & local)
# --------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=jalmitra_db

# Enable SSL for cloud MySQL providers (Aiven, TiDB Cloud, Railway, AWS RDS)
# Set to 'true' in production; leave 'false' for local XAMPP/MySQL
DB_SSL=false

# Optional connection limit (defaults: 3 on Vercel Serverless, 10 on Render/Server)
DB_CONNECTION_LIMIT=10

# --------------------------------------------------------
# Security, CORS & Authentication
# --------------------------------------------------------
# Allowed Frontend Origin for CORS (comma-separated if multiple)
FRONTEND_URL=https://gram-panchayat-portal-sandy.vercel.app

# Strong Random JWT Secret for Signing Authentication Tokens
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string_in_production
