# ========================================================
# Gram Panchayat Portal Frontend - Environment Configuration
# Copy this file to '.env.production' or configure in Vercel
# ========================================================

# Base API URL for Express REST Backend:
# - Option A (Vercel Serverless on same domain): leave blank or set to /api
# - Option B (Separate host like Render or Railway): set to https://<your-backend-host>/api
# - Local development (default): http://localhost:5000/api
VITE_API_BASE_URL=
