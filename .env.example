# ========================================================
# Gram Panchayat Portal Frontend & Full-Stack Deployment Config
# Configure these environment variables in your Vercel Project Settings:
# Settings -> Environment Variables -> Production
# ========================================================

# 1. Frontend API Route:
# For Vercel same-domain serverless functions, leave blank or set to /api
VITE_API_BASE_URL=

# 2. Backend Database Provider:
DB_PROVIDER=firestore

# 3. Firebase Cloud Firestore Credentials (from Firebase Service Account):
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Authentication Secret:
JWT_SECRET=your_secure_random_jwt_secret_64_characters
